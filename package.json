{
  "name": "dsh-550c-boot",
  "version": "0.3.3",
  "description": "550C 开机动画：启动 DSH 时播放 550C 片头，简易模式只播 logo 加载动画，完整模式播完整的覆写流程；通用设置里可切换或关闭。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "Ziyang Song",
    "url": "https://github.com/yannicksong0106"
  },
  "contributors": [
    {
      "name": "Voidpocket",
      "url": "https://github.com/Voidpocket",
      "comment": "550C 片头动画与 HTML 源码（assets/550C-source.html）"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannicksong0106/dsh-550c-boot.git"
  },
  "homepage": "https://github.com/yannicksong0106/dsh-550c-boot#readme",
  "bugs": {
    "url": "https://github.com/yannicksong0106/dsh-550c-boot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "boot-animation",
    "splash",
    "startup",
    "theme",
    "web-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "web:index-inject",
      "dom:overlay",
      "browser:local-storage",
      "desktop:titlebar-overlay",
      "web:http-route",
      "network:npm-registry"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.0-rc.1"
      ]
    },
    "capability": {
      "id": "boot-splash",
      "kind": "ui",
      "invocation": "Boot the profile's Web GUI, then read the first frame from the page: document.querySelector('.dsh550c-host') and its shadowRoot's #boot stage, plus document.documentElement.classList.contains('dsh550c-first') on the way in.",
      "expected": "The host half's first frame covers the shell while the document is still parsing, so DSH's [data-dsh-boot] card is never visible; the client splash then mounts the ported #boot stage in a shadow root on the same task that retires that cover, and plays to completion."
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "build": "node scripts/extract.mjs && node scripts/build.mjs",
    "check": "node --check lib/client.js && node --check lib/index.js",
    "test": "node scripts/test-host.mjs",
    "test:harness": "node scripts/harness/build.mjs && node scripts/harness/run.mjs",
    "verify": "npm run build && npm run check && npm test && npm run test:harness",
    "prepublishOnly": "node scripts/extract.mjs && node scripts/build.mjs && node --check lib/client.js && node --check lib/index.js"
  },
  "dependencies": {}
}
